# ==============================================================================
# CARspective — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Never commit .env containing real credentials or secrets to version control.
# 3. For production deployments, ensure all secrets are generated using a
#    cryptographically secure random generator (e.g., openssl rand -hex 32).
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
# In production, debug mode is forced to False and secure keys are strictly enforced.
CARSPECTIVE_ENV=development

# Debug Mode: true or false (MUST be false in production)
CARSPECTIVE_DEBUG=false

# Server Port
PORT=5000

# Secret Key for cryptographic session signing and CSRF tokens
# In production: MUST be set to a cryptographically strong random string (min 16 chars, recommend 64+ hex)
# Example generation: openssl rand -hex 32
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars

# Administrative API Key for protected ingestion/pipeline management routes (/api/v1/data/admin/*, /api/v1/market/admin/*)
# In production: MUST be set to a dedicated random key (min 16 chars)
# Example generation: openssl rand -hex 24
ADMIN_API_KEY=replace-with-a-cryptographically-secure-admin-api-key-min-24-chars

# Database Connection URL
# Development default: SQLite local file
# Production example: postgresql+psycopg2://carspective_app:DB_PASSWORD@db-host:5432/carspective_prod
DATABASE_URL=sqlite:///data/database/carspective.db

# Allowed Host Headers for Host Header Spoofing / DNS Rebinding Protection
# Comma-separated list of hostnames/IPs accepted by the application
# Example: localhost,127.0.0.1,api.carspective.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# Trusted Reverse Proxy Hops (ProxyFix middleware)
# Set to the number of reverse proxies in front of the application (e.g., Nginx, ALB, Cloudflare).
# 0 = Directly exposed or testing (default)
# 1 = Single reverse proxy (e.g., Nginx or AWS ALB)
# 2 = Two reverse proxies (e.g., Cloudflare -> Nginx)
TRUSTED_PROXIES=0

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated origins allowed to make browser requests.
# Note: Wildcard '*' is strictly prohibited in production mode.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
