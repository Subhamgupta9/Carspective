# ==============================================================================
# CARspective — Backend Production Environment Template (Render Web Service)
# Instructions: Copy variable names and configure values in Render Service Settings.
# WARNING: NEVER commit actual secrets, keys, or database credentials to Git.
# ==============================================================================

# Runtime Environment Modes
CARSPECTIVE_ENV=production
CARSPECTIVE_DEBUG=false

# Application Security Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=<generate-32-char-random-hex>
ADMIN_API_KEY=<generate-32-char-random-hex>

# Managed Cloud Database Connection (Neon Serverless PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint-id].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://<neon_username>:<neon_password>@<neon_endpoint_host>.neon.tech/<neon_database_name>?sslmode=require

# Database Schema Migrations (Optional)
# Recommended: Run migrations once manually via CLI during deployment preflight.
# Set AUTO_MIGRATE=false (default) to prevent unnecessary migration overhead on every cold start.
AUTO_MIGRATE=false

# Ingress Network Security
# ALLOWED_HOSTS: Hostnames permitted in the HTTP Host header (comma-separated, no protocols or ports)
# Note: localhost and 127.0.0.1 must be included for internal container health checks
ALLOWED_HOSTS=localhost,127.0.0.1,<your-service-name>.onrender.com,api.<your-custom-domain>.com

# CORS Allowed Origins: Exact browser origins permitted to issue requests (comma-separated, https:// required)
CORS_ALLOWED_ORIGINS=https://<your-app-name>.vercel.app,https://<your-custom-domain>.com

# Reverse Proxy Configuration
# TRUSTED_PROXIES: Set to 1 so Werkzeug ProxyFix trusts Render's edge load balancer
TRUSTED_PROXIES=1

# WSGI Process Concurrency Configuration
# Tuned for Render Free Tier (512 MB RAM ceiling)
# Single worker with 4 threads uses ~175 MB RAM (vs 685 MB for 4 workers)
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=60
