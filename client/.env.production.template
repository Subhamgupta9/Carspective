# ==============================================================================
# CARspective — Frontend Production Environment Template (Vercel Project)
# CRITICAL VERCEL SETTING: In Vercel Project Settings > General, set
# "Root Directory" to "client" so Vercel detects Vite and client/vercel.json.
# Instructions: Configure in Vercel Project Settings > Environment Variables.
# These values are injected at build time into the Vite bundle.
# ==============================================================================


# Backend API Base URL (Render Web Service HTTPS URL, no trailing slash)
# Example: https://carspective-api.onrender.com
VITE_API_URL=https://<your-backend-service-name>.onrender.com

# Request Timeout in Milliseconds
# Recommended: 75000 (75 seconds) to accommodate Render free-tier cold starts
VITE_API_TIMEOUT_MS=75000
